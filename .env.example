# ─────────────────────────────────────────────────────────────────────────────
# MT5 TRADING TERMINAL — BACKEND CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# ── Safety (MANDATORY) ───────────────────────────────────────────────────────
DEMO_ONLY=true                          # NEVER change. System refuses live accounts.

# ── MT5 Terminal ─────────────────────────────────────────────────────────────
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=                              # Optional: auto-attach if MT5 already open
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=30000

# ── Symbol ───────────────────────────────────────────────────────────────────
GOLD_SYMBOL=XAUUSD                      # Change if broker uses GOLD, XAUUSDm, etc.

# ── API Security ─────────────────────────────────────────────────────────────
API_TOKEN=dev-token-change-me           # Must match VITE_API_TOKEN in frontend/.env

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./mt5terminal.db

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ── Defaults ─────────────────────────────────────────────────────────────────
DEFAULT_MODE=DRY_RUN                    # DRY_RUN | DEMO_EXECUTION
LOG_LEVEL=INFO

# ── Optional: Lock to specific login ─────────────────────────────────────────
ALLOWED_LOGIN=                          # Refuse if connected login != this value
